{
  "name": "ochiga-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:workers": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "dev:events": "ts-node-dev --respawn --transpile-only src/events.ts",
    "smoke:ecosystem": "node scripts/ecosystem-smoke.mjs",
    "build": "tsc -p .",
    "smoke:watch": "npm run build && node scripts/watch-hardening-smoke.mjs",
    "start": "node dist/server.js",
    "start:workers": "node dist/worker.js",
    "start:events": "node dist/events.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.1",
    "aws-sdk": "^2.1570.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "ioredis": "^5.4.1",
    "ip-cidr": "^3.1.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.3.3",
    "morgan": "^1.10.0",
    "node-ssdp": "^4.0.1",
    "onvif": "^0.6.3",
    "openai": "^4.58.1",
    "ping": "^0.4.4",
    "qrcode": "^1.5.3",
    "redis": "^4.6.13",
    "resend": "^4.0.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.12.12",
    "@types/node-ssdp": "^4.0.1",
    "@types/ping": "^0.4.2",
    "@types/qrcode": "^1.4.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
