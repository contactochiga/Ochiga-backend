{
  "name": "ochiga-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:workers": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "dev:events": "ts-node-dev --respawn --transpile-only src/events.ts",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit --pretty false",
    "smoke:ecosystem": "node scripts/ecosystem-smoke.mjs",
    "smoke:invite-onboarding": "node scripts/invite-first-onboarding-smoke.mjs",
    "build": "tsc -p .",
    "smoke:watch": "npm run build && node scripts/watch-hardening-smoke.mjs",
    "start": "node dist/server.js",
    "start:workers": "node dist/worker.js",
    "start:events": "node dist/events.js",
    "smoke:oyi": "node scripts/oyi-unified-smoke.mjs",
    "smoke:oyi-awareness": "npm run build && node scripts/oyi-awareness-v3-smoke.mjs",
    "smoke:oyi-operating": "npm run build && node scripts/oyi-operating-layer-smoke.mjs",
    "smoke:oyi-conversation": "npm run build && node scripts/oyi-conversation-smoke.mjs",
    "smoke:oyi-language": "npm run build && node scripts/oyi-language-teacher-smoke.mjs",
    "smoke:intelligence-fabric": "npm run build && node scripts/intelligence-fabric-phase1-smoke.mjs",
    "smoke:intelligence-fabric-phase2": "npm run build && node scripts/intelligence-fabric-phase2-smoke.mjs",
    "smoke:workflow": "npm run smoke:intelligence-fabric-phase2",
    "smoke:execution": "npm run smoke:intelligence-fabric-phase2",
    "smoke:security-closure": "npm run build && node scripts/oyi-security-closure-smoke.mjs",
    "audit:security": "node scripts/oyi-security-audit.mjs",
    "smoke:security-adversarial": "npm run build && node scripts/oyi-security-adversarial-smoke.mjs",
    "smoke:notification-routing": "npm run build && node scripts/notification-routing-smoke.mjs",
    "smoke:oyi-targets": "npm run build && node scripts/oyi-target-smoke.mjs",
    "smoke:oyi-core-compatibility": "npm run build && node scripts/oyi-core-compatibility-smoke.mjs",
    "smoke:production-readiness": "npm run build && node scripts/production-readiness-smoke.mjs",
    "smoke:provider-health": "npm run build && node scripts/provider-health-smoke.mjs",
    "smoke:oyi-runtime": "npm run build && node scripts/oyi-runtime-smoke.mjs",
    "smoke:device-runtime": "npm run build && node scripts/device-runtime-adapter-smoke.mjs",
    "smoke:device-control-matrix": "npm run build && node scripts/device-control-matrix-smoke.mjs",
    "smoke:device-intelligence": "npm run build && node scripts/device-intelligence-smoke.mjs",
    "smoke:device-ir-sync": "npm run build && node scripts/device-ir-sync-smoke.mjs",
    "smoke:device-memory": "npm run build && node scripts/device-memory-smoke.mjs",
    "smoke:device-relationships": "npm run build && node scripts/device-relationships-smoke.mjs",
    "smoke:device-conversation": "npm run build && node scripts/device-conversation-smoke.mjs",
    "smoke:device-schema": "node scripts/device-schema-release-smoke.mjs",
    "smoke:infrastructure-intelligence": "npm run build && node scripts/infrastructure-event-intelligence-smoke.mjs",
    "smoke:execution-ledger": "npm run build && node scripts/execution-ledger-smoke.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:security": "node scripts/validate-security.mjs",
    "validate:release": "node scripts/validate-release.mjs && npm run smoke:device-schema && npm run smoke:device-control-matrix && npm run smoke:device-intelligence && npm run smoke:infrastructure-intelligence"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.1",
    "aws-sdk": "^2.1570.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "ioredis": "^5.4.1",
    "ip-cidr": "^3.1.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.3.3",
    "morgan": "^1.10.0",
    "node-ssdp": "^4.0.1",
    "onvif": "^0.6.3",
    "openai": "^4.58.1",
    "ping": "^0.4.4",
    "qrcode": "^1.5.3",
    "redis": "^4.6.13",
    "resend": "^4.0.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.12.12",
    "@types/node-ssdp": "^4.0.1",
    "@types/ping": "^0.4.2",
    "@types/qrcode": "^1.4.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
